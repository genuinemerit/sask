{
	order rate_limit before basicauth
	storage file_system {{ caddy_data_dir }}
}

{{ domain }} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer-when-downgrade"
		# style-src needs 'unsafe-inline': every page's CSS is a single
		# inline <style> block (base.html and the built API reference,
		# DD-0027) — 'self' alone (the default-src fallback) permits only
		# same-origin external stylesheets, not inline ones, so without
		# this every page rendered unstyled in any CSP-compliant browser
		# (found during SPEC-040/041 prod UAT — pre-existing since
		# SPEC-026, not introduced by that round). No untrusted/user-
		# generated HTML exists anywhere in this app, so the loosening is
		# scoped to styles only; script-src etc. still fall back to
		# default-src 'self'.
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
	}

	rate_limit {
		zone interactive {
			key {remote_host}
			events {{ rate_limit_default_events }}
			window {{ rate_limit_default_window }}
		}
		zone download {
			match {
				path /ephemeris/download*
			}
			key {remote_host}
			events {{ rate_limit_download_events }}
			window {{ rate_limit_download_window }}
		}
		zone asset {
			match {
				path /asset/*
			}
			key {remote_host}
			events {{ rate_limit_asset_events }}
			window {{ rate_limit_asset_window }}
		}
	}

	reverse_proxy {{ gunicorn_bind }}

	log {
		output file {{ caddy_log_dir }}/access.log
	}
}
